@page "/requests/new"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>New Request</PageTitle>
<MudText Typo="Typo.h4" Class="mb-1">Create Replenishment Request</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Create a draft, then submit it to start asynchronous stock validation.</MudText>

<MudPaper Class="pa-4">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="7"><MudTextField @bind-Value="_location" Label="Stock Location" Required="true" RequiredError="Location is required." /></MudItem>
            <MudItem xs="12" sm="5"><MudSelect T="RequestPriority" @bind-Value="_priority" Label="Priority" Required="true">@foreach (var p in Enum.GetValues<RequestPriority>()) { <MudSelectItem Value="@p">@p</MudSelectItem> }</MudSelect></MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-6 mb-2">Material Items</MudText>
        @foreach (var item in _items)
        {
            <MudGrid Class="mb-2" @key="item">
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="item.ArticleNumber" Label="Article Number" Required="true" /></MudItem>
                <MudItem xs="12" sm="5"><MudTextField @bind-Value="item.Description" Label="Description" Required="true" /></MudItem>
                <MudItem xs="10" sm="3"><MudNumericField T="decimal" @bind-Value="item.RequestedQuantity" Label="Requested Quantity" Min="0.01m" Required="true" /></MudItem>
                <MudItem xs="2" sm="1" Class="d-flex align-center"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="@(_items.Count == 1)" OnClick="() => RemoveItem(item)" /></MudItem>
            </MudGrid>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem">Add Item</MudButton>

        <MudDivider Class="my-5" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Href="/" Variant="Variant.Text">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="CreateAsync">Create Draft</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm? _form;
    private string _location = "Line A - Assembly";
    private RequestPriority _priority = RequestPriority.Normal;
    private readonly List<NewItemModel> _items = [new()];
    private bool _saving;

    private void AddItem() => _items.Add(new NewItemModel());
    private void RemoveItem(NewItemModel item) => _items.Remove(item);

    private async Task CreateAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid || _items.Any(i => string.IsNullOrWhiteSpace(i.ArticleNumber) || string.IsNullOrWhiteSpace(i.Description) || i.RequestedQuantity <= 0))
        {
            Snackbar.Add("Please complete all material fields with valid quantities.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = await Api.CreateAsync(new CreateReplenishmentRequest(_location, _priority,
                _items.Select(i => new CreateReplenishmentItem(i.ArticleNumber.Trim(), i.Description.Trim(), i.RequestedQuantity)).ToList()));
            if (!result.Success) { Snackbar.Add(result.Error ?? "Unable to create request.", Severity.Error); return; }
            Snackbar.Add("Draft created successfully.", Severity.Success);
            Navigation.NavigateTo($"/requests/{result.Data!.Id}");
        }
        finally { _saving = false; }
    }

    private sealed class NewItemModel
    {
        public string ArticleNumber { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal RequestedQuantity { get; set; } = 1;
    }
}
