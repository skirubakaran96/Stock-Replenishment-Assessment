@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">Stock Replenishment</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Hitachi Energy Assignment</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Inventory">Requests</MudNavLink>
            <MudNavLink Href="/requests/new" Icon="@Icons.Material.Filled.AddCircle">New Request</MudNavLink>
            <MudNavLink Href="/swagger" Icon="@Icons.Material.Filled.Api">API / Swagger</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
